    7          uint8 PWM_Count = 40; //占空比
    8          
    9          
   10          void Timer4Init(void)
   11          {
   12   1        T4T3M &= 0xBF;                  //定时器4设置为定时方式
   13   1        T4T3M |= 0x20;                  //设置定时器4为1T模式
   14   1        T4L = 0x90;                     //1T模式下初始装载值 
   15   1        T4H = 0xE8;                     //1T模式下初始装载值 
   16   1        IE2  |=  (1<<6);                //使能定时器4中断
   17   1        T4T3M |= 0x80;                  //打开定时器4
   18   1      } 
   19          
   20          
   21          void timer4_int (void) interrupt 20
   22          {
   23   1          if(++Time_Count>=4000) //最长计时间 1s
   24   1          {
   25   2             Time_Count=0;
   26   2          }  
   27   1           if(++Time_Count_pwm>100)
   28   1         {
   29   2            Time_Count_pwm=0;
   30   2         } 
   31   1         if(Time_Count_pwm>=PWM_Count)//PWM调速
   32   1         {
   33   2            Car_Stop(); //置为低电平   
   34   2           
   35   2         }else{    
   36   2           
   37   2            Adjust_Pwm_data();//调节PWM
   38   2         } 
   39   1      } 
