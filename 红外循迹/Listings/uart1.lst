    8          void Uart1_Init(void)
    9          {  
   10   1        P3M1 &= 0xFC; P3M0 &= 0xFC;                   //设置P3.0 ,P3.1为准双向口  
   11   1        
   12   1        PCON &= 0x3f;   //波特率不倍速，串行口工作方式由SM0、SM1决定
   13   1        SCON = 0x50;    //8位数据,可变波特率，启动串行接收器
   14   1        AUXR |= 0x40;   //定时器1时钟为Fosc,即1T
   15   1        AUXR &= 0xfe;   //串口1选择定时器1为波特率发生器
   16   1        TMOD &= 0x0f;   //清除定时器1模式位
   17   1        TMOD |= 0x20;   //设定定时器1为8位自动重装方式
   18   1        TL1 = 0xB2;     //设定定时初值
   19   1        TH1 = 0xB2;     //设定定时器重装值
   20   1        ET1 = 0;        //禁止定时器1中断
   21   1        TR1 = 1;        //启动定时器1
   22   1        ES = 1;         // 串口1中断打开 
   23   1        
   24   1        EA = 1;               //总中断打开 
   25   1        
   26   1        delay_ms(100);
   27   1      }
