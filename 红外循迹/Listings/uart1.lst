   56          void program_automatic_update(void)
   57          {
   58              static unsigned char recv_cnt = 0;
   59              if (SBUF == 0xAF)
   60              {
   61                  if (++recv_cnt >= 5)
   62                  {
   63                      recv_cnt = 0;
   64                      IAP_CONTR = 0x60;   //触发软件复位，从ISP开始执行
   65                  }
   66              }
   67              else
   68              {
   69                  recv_cnt = 0;
   70              }
   71          }
